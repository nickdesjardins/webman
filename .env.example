# Copy to .env.local and fill in to enable the contact form (/api/contact).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Where contact messages are delivered, and the From address used to send them.
CONTACT_TO=nick.desjardins@live.com
CONTACT_FROM=no-reply@webman.dev
